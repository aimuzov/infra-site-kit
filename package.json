{
	"name": "@aimuzov/infra-site-kit",
	"version": "5.9.1",
	"private": true,
	"description": "Shared site checks, deployment, formatting and PostCSS configs, Svelte UI, typography, titles, SEO, tooltips, navigation, analytics and reader changelogs",
	"license": "MIT",
	"repository": "github:aimuzov/infra-site-kit",
	"type": "module",
	"exports": {
		"./prettier": "./prettier.mjs",
		"./stylelint": "./stylelint.mjs",
		"./oxlint.json": "./oxlint.json",
		"./credit.astro": "./site/credit.astro",
		"./credit.svelte": {
			"types": "./site/credit.svelte.d.ts",
			"svelte": "./site/credit.svelte",
			"default": "./site/credit.svelte"
		},
		"./year.js": "./site/year.js",
		"./mark.js": {
			"types": "./site/mark.d.ts",
			"default": "./site/mark.js"
		},
		"./sitemap.js": {
			"types": "./site/sitemap.d.ts",
			"default": "./site/sitemap.js"
		},
		"./not-found.astro": "./site/not-found.astro",
		"./not-found.js": {
			"types": "./site/not-found.d.ts",
			"default": "./site/not-found.js"
		},
		"./theme-peek.js": {
			"types": "./site/theme-peek.d.ts",
			"default": "./site/theme-peek.js"
		},
		"./theme-peek.css": "./site/theme-peek.css",
		"./base.css": "./site/base.css",
		"./theme.js": {
			"types": "./site/theme.d.ts",
			"default": "./site/theme.js"
		},
		"./theme-boot.astro": "./site/theme-boot.astro",
		"./panels.js": {
			"types": "./site/panels.d.ts",
			"default": "./site/panels.js"
		},
		"./panels-boot.astro": "./site/panels-boot.astro",
		"./section-spy.js": {
			"types": "./site/section-spy.d.ts",
			"default": "./site/section-spy.js"
		},
		"./i18n.js": {
			"types": "./site/i18n.d.ts",
			"default": "./site/i18n.js"
		},
		"./i18n-head.astro": "./site/i18n-head.astro",
		"./locale-boot.astro": "./site/locale-boot.astro",
		"./metrika.astro": "./site/metrika.astro",
		"./metrika-pixel.astro": "./site/metrika-pixel.astro",
		"./sentry.astro": "./site/sentry.astro",
		"./sentry-sourcemaps.js": {
			"types": "./site/sentry-sourcemaps.d.ts",
			"default": "./site/sentry-sourcemaps.js"
		},
		"./changelog.js": {
			"types": "./site/changelog.d.ts",
			"default": "./site/changelog.js"
		},
		"./changelog.astro": "./site/changelog.astro",
		"./playwright": {
			"types": "./playwright/config.d.mts",
			"default": "./playwright/config.mjs"
		},
		"./playwright/checks": {
			"types": "./playwright/checks.d.mts",
			"default": "./playwright/checks.mjs"
		},
		"./ui/tokens.css": "./site/ui/tokens.css",
		"./ui/files.js": {
			"types": "./site/ui/files.d.ts",
			"default": "./site/ui/files.js"
		},
		"./ui/*.svelte": {
			"types": "./site/ui/*.svelte.d.ts",
			"svelte": "./site/ui/*.svelte",
			"default": "./site/ui/*.svelte"
		},
		"./escape.js": {
			"types": "./site/escape.d.ts",
			"default": "./site/escape.js"
		},
		"./back-link.js": {
			"types": "./site/back-link.d.ts",
			"default": "./site/back-link.js"
		},
		"./typograph.js": {
			"types": "./site/typograph.d.ts",
			"default": "./site/typograph.js"
		},
		"./typograph-middleware.js": {
			"types": "./site/typograph-middleware.d.ts",
			"default": "./site/typograph-middleware.js"
		},
		"./title.js": {
			"types": "./site/title.d.ts",
			"default": "./site/title.js"
		},
		"./tooltip.js": {
			"types": "./site/tooltip.d.ts",
			"default": "./site/tooltip.js"
		},
		"./postcss": {
			"types": "./postcss.d.mts",
			"default": "./postcss.mjs"
		},
		"./seo.astro": "./site/seo.astro"
	},
	"bin": {
		"site-changelog": "./bin/site-changelog.mjs"
	},
	"files": [
		"prettier.mjs",
		"stylelint.mjs",
		"oxlint.json",
		"bin",
		"changelog",
		"playwright",
		"site",
		"postcss.mjs",
		"postcss.d.mts"
	],
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "astro check --root test/astro && svelte-check --workspace test/astro --fail-on-warnings",
		"test": "node --import ./test/svelte-register.mjs --test 'test/*.test.mjs'",
		"test:e2e": "vite build -c test/ui/vite.config.mjs && pagefind --site test/ui/dist --silent && playwright test"
	},
	"dependencies": {
		"@axe-core/playwright": "4.13.0",
		"@csstools/postcss-global-data": "4.0.0",
		"@ianvs/prettier-plugin-sort-imports": "4.7.1",
		"@sentry/browser": "11.8.0",
		"@sentry/vite-plugin": "11.9.0",
		"@stylistic/eslint-plugin": "5.10.0",
		"postcss": "8.5.30",
		"postcss-custom-media": "12.0.3",
		"postcss-html": "2.0.0",
		"postcss-nested": "8.0.1",
		"prettier-plugin-astro": "1.1.0",
		"prettier-plugin-svelte": "4.1.1",
		"stylelint-config-clean-order": "10.0.0",
		"stylelint-order": "8.1.1"
	},
	"peerDependencies": {
		"@lucide/svelte": "^1.39.0",
		"@playwright/test": "^1.64.0",
		"astro": "^7.0.0",
		"oxlint": "^1.87.0",
		"prettier": "^3.9.0",
		"stylelint": "^17.16.0",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"@astrojs/svelte": "9.0.1",
		"@lucide/svelte": "1.39.0",
		"@playwright/test": "1.64.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"astro": "7.3.7",
		"oxlint": "1.87.0",
		"pagefind": "1.5.2",
		"prettier": "3.9.9",
		"stylelint": "17.16.0",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3",
		"vite": "8.3.4"
	},
	"keywords": [
		"astro-component",
		"svelte"
	],
	"peerDependenciesMeta": {
		"@playwright/test": {
			"optional": true
		},
		"astro": {
			"optional": true
		},
		"svelte": {
			"optional": true
		},
		"@lucide/svelte": {
			"optional": true
		}
	}
}
